          "stringUnit": {
            "state": "translated",
            "value": "やり直す"
          }
        }
      }
    },
    "Restore from History": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴から復元"
          }
        }
      }
    },
    "Return adds a new line · ⌘Return copies and clears": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Return で改行 · ⌘Return でコピーして消去"
          }
        }
      }
    },
    "Return always adds a new line, and confirming Japanese input never triggers anything — so nothing gets sent by accident.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Return は常に改行です。日本語の変換を確定しても何も起きないので、うっかり送信してしまうことはありません。"
          }
        }
      }
    },
    "Returns the text you last copied with Copy & Clear in FloatDraft, or empty text if there is none.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FloatDraft の「コピーして消去」で最後にコピーしたテキストを返します。まだない場合は空のテキストを返します。"
          }
        }
      }
    },
    "Search history": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴を検索"
          }
        }
      }
    },
    "Select All": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてを選択"
          }
        }
      }
