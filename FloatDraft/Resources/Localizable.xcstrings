{
  "sourceLanguage": "en",
  "strings": {
    "%lld chars · %lld non-space · %lld lines": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld chars · %2$lld non-space · %3$lld lines"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 文字 · 空白除く %2$lld · %3$lld 行"
