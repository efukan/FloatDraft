          }
        }
      }
    },
    "Press ⌘Return to copy and clear the draft. You're taken back to your app; press ⌘V to paste.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘Return で下書きをコピーして消去します。元のアプリに戻るので、⌘V で貼り付けてください。"
