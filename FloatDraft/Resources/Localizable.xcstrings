    "Add Text to Draft": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストを下書きに追加"
          }
        }
      }
    },
    "Adds text to the FloatDraft draft. An empty draft is replaced; otherwise the text is added on a new line at the end. You can undo it with Command-Z in the panel.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "FloatDraft の下書きにテキストを追加します。下書きが空なら置き換え、空でなければ末尾に改行して追加します。パネルで ⌘Z を押すと取り消せます。"
          }
        }
      }
    },
    "Allow FloatDraft in System Settings › General › Login Items.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定」›「一般」›「ログイン項目」で FloatDraft を許可してください。"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外観"
          }
