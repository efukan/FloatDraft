        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景"
          }
        }
      }
    },
    "Background opacity and pinning are in the panel itself (the slider icon in its header), so you can preview them live.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景の不透明度とピン留めは、パネル上部のスライダーアイコンから設定します。その場で見た目を確認できます。"
          }
